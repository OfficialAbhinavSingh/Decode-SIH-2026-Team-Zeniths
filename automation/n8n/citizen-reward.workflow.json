{
  "name": "NeerDrishti - Citizen Gamification Reward (Water Warrior)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "citizen-reward",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "node-webhook-1",
      "name": "Backend Triggers Reward",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [200, 300],
      "webhookId": "reward-webhook-id"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TELEGRAM_BOT_TOKEN ? 'https://api.telegram.org/bot' + $env.TELEGRAM_BOT_TOKEN + '/sendMessage' : 'https://httpbin.org/post' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chat_id\": \"{{ $json.body.chat_id_from_cache }}\",\n  \"text\": \"🏆 *Congratulations, Water Warrior!* 🏆\\n\\nHi there! Remember the water leak you reported at *{{ $json.body.location }}*?\\n\\nWe are thrilled to tell you that our NeerDrishti field crew has successfully fixed it! 🛠️✅\\n\\nBecause of your quick action, you just helped save approximately *{{ $json.body.liters_saved }} liters* of drinking water for our city. 💧💙\\n\\nYou have been awarded the digital *Water Warrior Badge*! Thank you for being an active, responsible citizen.\",\n  \"parse_mode\": \"Markdown\"\n}",
        "options": {}
      },
      "id": "node-telegram-2",
      "name": "Send 'Water Warrior' Telegram Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [500, 300]
    }
  ],
  "connections": {
    "Backend Triggers Reward": {
      "main": [
        [
          {
            "node": "Send 'Water Warrior' Telegram Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "NeerDrishti"
    },
    {
      "name": "Gamification"
    }
  ]
}
